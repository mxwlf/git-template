# ==============================================================================
# .gitattributes — Git Attributes
# Normalize line endings, mark binary files, configure diff drivers.
# ==============================================================================

# Auto-detect text files and normalize line endings to LF in the repository.
# On checkout, Windows will convert LF → CRLF; Unix/macOS keep LF.
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Explicitly declare text file types
# ---------------------------------------------------------------------------

# General
*.txt        text
*.md         text diff=markdown
*.rst        text
*.csv        text
*.tsv        text
*.toml       text
*.ini        text
*.cfg        text
*.conf       text
*.env        text
*.env.*      text
*.editorconfig text

# Web
*.html       text diff=html
*.htm        text diff=html
*.css        text diff=css
*.scss       text
*.sass       text
*.less       text
*.js         text diff=javascript
*.jsx        text diff=javascript
*.ts         text diff=javascript
*.tsx        text diff=javascript
*.json       text
*.jsonc      text
*.json5      text
*.xml        text diff=xml
*.svg        text
*.graphql    text
*.gql        text

# Shell / Scripts
*.sh         text eol=lf
*.bash       text eol=lf
*.zsh        text eol=lf
*.fish       text eol=lf
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Config / CI
*.yml        text
*.yaml       text
Makefile     text eol=lf
makefile     text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf
.gitignore   text
.gitattributes text
.editorconfig  text

# Languages
*.py         text diff=python
*.rb         text diff=ruby
*.java       text diff=java
*.kt         text
*.kts        text
*.go         text
*.rs         text
*.c          text diff=cpp
*.cc         text diff=cpp
*.cpp        text diff=cpp
*.cxx        text diff=cpp
*.h          text diff=cpp
*.hpp        text diff=cpp
*.cs         text diff=csharp
*.php        text
*.swift      text
*.ex         text
*.exs        text
*.erl        text
*.hs         text
*.lua        text
*.r          text
*.R          text
*.sql        text

# Documentation / markup
*.tex        text diff=tex
*.bib        text

# ---------------------------------------------------------------------------
# Binary files — never diff or merge as text
# ---------------------------------------------------------------------------

# Images
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.bmp        binary
*.tiff       binary
*.tif        binary
*.webp       binary
*.avif       binary
*.heic       binary
*.heif       binary
*.psd        binary
*.ai         binary
*.sketch     binary

# Audio / Video
*.mp3        binary
*.mp4        binary
*.avi        binary
*.mov        binary
*.mkv        binary
*.wav        binary
*.flac       binary
*.ogg        binary

# Fonts
*.ttf        binary
*.otf        binary
*.woff       binary
*.woff2      binary
*.eot        binary

# Archives / Packages
*.zip        binary
*.tar        binary
*.tar.gz     binary
*.tgz        binary
*.tar.bz2    binary
*.tar.xz     binary
*.gz         binary
*.bz2        binary
*.xz         binary
*.7z         binary
*.rar        binary
*.jar        binary
*.war        binary
*.ear        binary
*.gem        binary
*.whl        binary
*.egg        binary

# Compiled / executables
*.exe        binary
*.dll        binary
*.so         binary
*.dylib      binary
*.a          binary
*.lib        binary
*.o          binary
*.obj        binary
*.pyc        binary
*.pyo        binary
*.class      binary
*.wasm       binary

# Documents
*.pdf        binary
*.doc        binary
*.docx       binary
*.xls        binary
*.xlsx       binary
*.ppt        binary
*.pptx       binary

# Database / binary data
*.db         binary
*.sqlite     binary
*.sqlite3    binary
*.dump       binary

# ---------------------------------------------------------------------------
# Git diff drivers (requires matching [diff "<driver>"] in .gitconfig)
# ---------------------------------------------------------------------------

# Show function context in diffs for common languages
*.md         diff=markdown
*.py         diff=python
*.rb         diff=ruby
*.java       diff=java
*.c          diff=cpp
*.cpp        diff=cpp
*.h          diff=cpp

# ---------------------------------------------------------------------------
# GitHub / GitLab linguist overrides
# ---------------------------------------------------------------------------

# Exclude vendored / generated files from language stats
vendor/**    linguist-vendored
node_modules/** linguist-vendored
dist/**      linguist-generated
build/**     linguist-generated
*.min.js     linguist-generated
*.min.css    linguist-generated
